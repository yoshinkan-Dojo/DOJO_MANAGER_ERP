PROJECT_NAME=DOJO_MANAGER ERP
VERSION=0.9.5
ENVIRONMENT=development
SQLALCHEMY_ECHO=false
JWT_SECRET_KEY=change-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Valores locais de exemplo. Nao use estas credenciais fora do ambiente de desenvolvimento.
POSTGRES_DB=dojo_manager
POSTGRES_USER=dojo_manager
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://dojo_manager:change-me-local-only@localhost:5432/dojo_manager
